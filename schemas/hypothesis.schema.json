{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://crypto-lab/schemas/hypothesis.schema.json",
  "title": "Hypothesis",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "claim",
    "mechanism",
    "math_form",
    "target",
    "horizon",
    "assumptions",
    "failure_conditions",
    "live_parity",
    "null_hypothesis",
    "effect_size_of_interest",
    "src_ids",
    "lessons_reviewed",
    "bounded_search_space"
  ],
  "properties": {
    "claim": {"type": "string", "minLength": 12,
      "description": "the falsifiable statement being tested"},
    "mechanism": {"type": "string", "minLength": 20,
      "description": "WHY this should predict - economic / microstructure story"},
    "math_form": {"type": "string", "minLength": 3,
      "description": "explicit formula for the signal / feature"},
    "target": {"type": "string",
      "description": "what is predicted, e.g. ret_fwd_1h, sign_fwd_4h, vol_fwd_1d"},
    "horizon": {"type": "string",
      "enum": ["5m", "15m", "1h", "4h", "1d", "3d"]},
    "assumptions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "failure_conditions": {"type": "array", "items": {"type": "string"},
      "minItems": 1,
      "description": "conditions under which the mechanism should NOT work"},
    "live_parity": {"type": "object", "required": ["computable_realtime", "inputs", "latency_budget_ms"],
      "properties": {
        "computable_realtime": {"type": "boolean"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "latency_budget_ms": {"type": "number"}
      },
      "description": "R7 - must be computable in real time"},
    "null_hypothesis": {"type": "string", "minLength": 6,
      "description": "e.g. 'IC = 0', 'net Sharpe <= 0 after costs'"},
    "effect_size_of_interest": {"type": "number", "exclusiveMinimum": 0,
      "description": "smallest effect worth detecting - drives power.py"},
    "src_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1,
      "description": "ledger source ids (SRC-...) backing the idea"},
    "lessons_reviewed": {"type": "boolean", "const": true,
      "description": "theorist MUST query lessons before proposing (R4/charter)"},
    "bounded_search_space": {"type": "object",
      "required": ["parameters", "n_configs_max"],
      "properties": {
        "parameters": {"type": "object",
          "additionalProperties": {"type": "array"}},
        "n_configs_max": {"type": "integer", "minimum": 1}
      },
      "description": "pre-registered grid; R4 - changing it = new hypothesis"},
    "family": {"type": "string"},
    "parent_id": {"type": ["string", "null"],
      "description": "if this is a re-spec, the HYP it descends from (R4)"}
  }
}
